# ============================================
# CrewCmd — Environment Configuration
# ============================================
# Copy this to .env.local for local pnpm dev, or .env for Docker Compose.
#
# Docker Compose reads .env by default.
# For local dev: leave DATABASE_URL empty to use PGlite (zero-config).

# ── Database ─────────────────────────────────────────────────────
# Neon, Supabase, or any Postgres. Leave empty for PGlite local dev.
# Docker Compose sets this automatically — no need to change.
# DATABASE_URL="postgresql://user:password@host:5432/crewcmd?sslmode=require"

# Docker Compose Postgres password (only used by docker-compose.yml)
POSTGRES_PASSWORD="crewcmd"

# ── Auth ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# Runtime gateway tokens are encrypted with AES-256-GCM. When this keyring is
# unset, CrewCmd derives a compatibility key from AUTH_SECRET. For production,
# generate a dedicated key with: openssl rand -base64 32
# CREWCMD_RUNTIME_TOKEN_KEYS='{"2026-07":"BASE64_32_BYTE_KEY"}'
# CREWCMD_RUNTIME_TOKEN_ACTIVE_KEY_ID="2026-07"

# Canonical public origin used by Auth.js in production. Keep this identical
# to NEXT_PUBLIC_APP_URL, including scheme and non-default port.
AUTH_URL="http://localhost:3000"

# Reserved: GitHub OAuth is not wired in the default auth provider yet.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Native iOS background voice uses URLSession, so it cannot call Capacitor's
# local capacitor:// origin. Set this to the CrewCmd server URL reachable from
# the phone (for example, a Tailscale or public HTTPS URL) before rebuilding
# the Capacitor app. Falls back to NEXT_PUBLIC_APP_URL when unset.
# NEXT_PUBLIC_CREWCMD_NATIVE_API_BASE_URL="https://crewcmd.example.com"

# ── Storage ──────────────────────────────────────────────────────
# Vercel Blob (for task images, agent avatars). Optional.
BLOB_READ_WRITE_TOKEN=""

# ── API Auth ─────────────────────────────────────────────────────
# Bearer token for agent heartbeats and API mutations
# Generate: openssl rand -hex 32
HEARTBEAT_SECRET=""

# ── Integrations (Optional) ─────────────────────────────────────

# OpenClaw gateway for agent orchestration.
# Same-machine default: http://localhost:18789
# Remote/Tailscale: use the reachable gateway host URL.
# OPENCLAW_GATEWAY_URL="http://localhost:18789"

# ClawHub catalog/native skill install settings. CrewCMD uses these for
# browse normalization; OpenClaw also honors OPENCLAW_CLAWHUB_* during
# gateway-native skills.install/update and .clawhub/lock.json maintenance.
# 
# Enable ClawHub catalog for live skill browsing (recommended)
CREWCMD_CLAWHUB_CATALOG_ENABLED="true"
CREWCMD_CLAWHUB_CATALOG_URL="https://clawhub.ai"
# CREWCMD_CLAWHUB_TOKEN=""
# CREWCMD_CLAWHUB_CATALOG_TIMEOUT_MS="5000"
# OPENCLAW_CLAWHUB_URL="https://clawhub.ai"
# OPENCLAW_CLAWHUB_TOKEN=""

# Slack notifications
# SLACK_BOT_TOKEN="xoxb-..."
# SLACK_NOTIFICATION_CHANNEL="U..."

# Mobile native push notifications for Capacitor self-hosted apps
CREWCMD_PUSH_ENABLED="false"
# Android / FCM HTTP v1. Paste the full Firebase service account JSON.
# CREWCMD_PUSH_FCM_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# iOS / APNs token auth. Use the same bundle id as the signed Capacitor app.
# CREWCMD_PUSH_APNS_TEAM_ID=""
# CREWCMD_PUSH_APNS_KEY_ID=""
# CREWCMD_PUSH_APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# CREWCMD_PUSH_APNS_BUNDLE_ID=""
# CREWCMD_PUSH_APNS_ENV="sandbox"

# Default human assignee for escalated tasks
# DEFAULT_HUMAN_ASSIGNEE="admin"

# GitHub webhook for PR tracking
# GITHUB_WEBHOOK_SECRET=""

# ── Docker Compose Overrides ────────────────────────────────────
# APP_PORT=3000
# POSTGRES_PORT=5432
