{
  "name": "@crewcmd/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CrewCmd mobile shell for self-hosted and enterprise distribution.",
  "scripts": {
    "brand": "CREWCMD_MOBILE_MANIFEST=../../docs/examples/mobile/org.mobile.example.json node scripts/apply-branding.mjs",
    "brand:local": "CREWCMD_MOBILE_MANIFEST=./org.mobile.local.json node scripts/apply-branding.mjs",
    "brand:manifest": "node scripts/apply-branding.mjs",
    "check": "node scripts/check-web-assets.mjs",
    "ios:audio-session": "node scripts/ensure-ios-audio-session.mjs",
    "ios:voice-session": "node scripts/ensure-ios-voice-session.mjs",
    "copy": "pnpm exec cap copy",
    "sync": "pnpm exec cap sync",
    "open:ios": "pnpm exec cap open ios",
    "open:android": "pnpm exec cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "sharp": "^0.34.4"
  }
}
