meta {
  name: Create Doc
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/docs
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
  Content-Type: application/json
}

body:json {
  {
    "title": "New Document",
    "content": "# Document Content\n\nMarkdown content here.",
    "workspaceId": "{{workspace_id}}",
    "category": "general",
    "docType": "guide",
    "visibility": "company",
    "authorAgentId": "agent-forge",
    "projectId": "{{project_id}}",
    "tags": ["example"],
    "pinned": false
  }
}
