meta {
  name: List Docs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/docs
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
}

params:query {
  workspaceId: {{workspace_id}}
  ~companyId: {{company_id}}
  ~category: 
  ~docType: 
  ~visibility: 
  ~authorId: 
  ~projectId: 
  ~taskId: 
  ~tags: 
  ~pinned: 
  ~search: 
}
