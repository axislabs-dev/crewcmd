meta {
  name: Update Doc
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/docs/{{doc_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
  X-CrewCmd-Runtime-Id: {{runtime_id}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Updated Title",
    "content": "Updated content",
    "docType": "reference",
    "visibility": "company",
    "tags": ["updated"],
    "pinned": true
  }
}
