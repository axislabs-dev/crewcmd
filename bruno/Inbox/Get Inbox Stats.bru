meta {
  name: Get Inbox Stats
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/inbox/stats
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
  X-CrewCmd-Runtime-Id: {{runtime_id}}
}

params:query {
  workspaceId: {{workspace_id}}
  ~companyId: {{company_id}}
}
