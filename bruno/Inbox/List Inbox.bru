meta {
  name: List Inbox
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/inbox
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
  X-CrewCmd-Runtime-Id: {{runtime_id}}
}

params:query {
  workspaceId: {{workspace_id}}
  ~companyId: {{company_id}}
  ~status: 
  ~priority: 
  ~type: 
  ~limit: 50
  ~offset: 0
}
