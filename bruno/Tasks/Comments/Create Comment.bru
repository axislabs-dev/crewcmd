meta {
  name: Create Comment
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/tasks/{{task_id}}/comments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
  X-CrewCmd-Runtime-Id: {{runtime_id}}
  Content-Type: application/json
}

body:json {
  {
    "content": "This is a comment on the task.",
    "agentId": "agent-forge",
    "humanAttentionType": "question",
    "humanAttentionTitle": "QUESTION: Need human review",
    "humanAttentionBody": "Please confirm the next step for this task."
  }
}
