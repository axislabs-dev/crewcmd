meta {
  name: List Tasks
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/tasks
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
  X-CrewCmd-Runtime-Id: {{runtime_id}}
}

params:query {
  workspaceId: {{workspace_id}}
  ~companyId: {{company_id}}
  ~status: 
  ~agentId: 
  ~priority: 
  ~unassigned: 
  ~excludeHumanAssignee: 
  ~since: 
}
