meta {
  name: Update Task
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/tasks/{{task_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{heartbeat_secret}}
  X-CrewCmd-Runtime-Id: {{runtime_id}}
  Content-Type: application/json
}

body:json {
  {
    "status": "review",
    "prUrl": "https://github.com/axislabs-dev/crewcmd/pull/999",
    "prStatus": "open"
  }
}

docs {
  Developer and reviewer tasks now require prUrl before moving to review.
  Add humanAttentionType if you need to escalate a blocker, question, decision, or review request.
}
